				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sindoor)",
					"text": "var(--wp--preset--color--card)"
				},
				"border": {
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--kajal)",
					"radius": "2px"
				},
				"typography": {
					"fontWeight": "700",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--5)",
						"right": "var(--wp--preset--spacing--5)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--kajal)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--kajal)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--kajal)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--hand)",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"border": {
					"width": "0 0 0 4px",
					"style": "solid"
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--kajal)",
					"width": "0 0 1.5px 0",
					"style": "solid"
				}
			}
		},
		"css": ":root{--pd-paper:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' seed='4'/><feColorMatrix values='0 0 0 0 .35  0 0 0 0 .25  0 0 0 0 .15  0 0 0 .22 0'/></filter><rect width='300' height='300' filter='url(%23n)'/></svg>\")}body{background-image:var(--pd-paper);background-attachment:fixed}:lang(hi){line-height:1.65}.pd-skip{position:absolute;left:8px;top:-80px;background:var(--wp--preset--color--kajal);color:var(--wp--preset--color--kagaz);padding:10px 16px;z-index:50}.pd-skip:focus{top:8px}:where(a,button,input,select,textarea,summary):focus-visible{outline:3px solid var(--wp--preset--color--neel);outline-offset:3px}.pd-eyebrow{font:700 .8125rem/1.3 var(--wp--preset--font-family--body);letter-spacing:.09em;text-transform:uppercase}.pd-double-rule{border:0;border-top:1.5px solid var(--wp--preset--color--kajal);border-bottom:1.5px solid var(--wp--preset--color--kajal);height:5px;width:3.2em;margin-inline:0}"
	},
