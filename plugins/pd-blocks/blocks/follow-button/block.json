{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pd/follow-button",
	"title": "Follow button",
	"category": "widgets",
	"description": "Follow or unfollow an artisan. Works without JavaScript as a form post.",
	"attributes": { "artisanPostId": { "type": "integer", "default": 0 } },
	"usesContext": [ "postId", "postType" ],
	"supports": { "html": false, "interactivity": true, "align": false },
	"textdomain": "pd-blocks",
	"render": "file:./render.php"
}
